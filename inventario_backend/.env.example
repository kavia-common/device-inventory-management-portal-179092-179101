# Backend environment example for Inventario API

# CORS origin (frontend URL)
FRONTEND_ORIGIN=http://localhost:3000

# SQLAlchemy database URL (preferred)
# Example for PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/inventario

# Alternatively, provide POSTGRES_* variables to build the URL:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventario
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Toggle SQL echo for debugging
SQL_ECHO=false
