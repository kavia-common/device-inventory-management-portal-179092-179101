# Flask app environment configuration
# Port used by the Flask development server (the orchestrator will map this for deployment)
FLASK_RUN_PORT=3001

# CORS: Frontend origin allowed to access this backend
FRONTEND_ORIGIN=http://localhost:3000

# Database connection string preferred by SQLAlchemy.
# Example for Postgres with psycopg2:
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/inventario

# Alternative explicit Postgres parts (used by deployment templates or other services)
# If these are provided, another step can build DATABASE_URL from them.
POSTGRES_URL=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventario
POSTGRES_PORT=5432
